@model UniRemoteExam.Areas.Admin.ViewModels.AuditPageVm

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "سجل العمليات";
}

<style>
    .audit-page { direction: rtl; text-align: right; }
    .audit-actions { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:20px; }
    .audit-btn { border:none; border-radius:15px; padding:11px 18px; font-weight:700; text-decoration:none; display:inline-block; }
    .audit-btn-green { background:#0f5132; color:#fff; }
    .audit-btn-light { background:#fff; color:#102a24; border:1px solid #e5ecef; }
    .audit-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; margin-bottom:22px; }
    .audit-card { background:#fff; border:1px solid #e5ecef; border-radius:24px; padding:22px; box-shadow:0 16px 35px rgba(16,42,36,.07); position:relative; overflow:hidden; }
    .audit-card::before { content:""; position:absolute; top:0; right:0; left:0; height:6px; background:linear-gradient(90deg,#0f5132,#198754,#b7791f); }
    .audit-label { color:#64748b; font-size:14px; font-weight:700; margin-bottom:12px; }
    .audit-value { color:#102a24; font-size:36px; font-weight:700; line-height:1; }
    .filter-card { background:#fff; border:1px solid #e5ecef; border-radius:24px; padding:18px; box-shadow:0 12px 28px rgba(16,42,36,.06); margin-bottom:22px; }
    .filter-form { display:grid; grid-template-columns:2fr 1fr auto; gap:12px; }
    .form-control-admin { border:1px solid #dce3e8; border-radius:14px; padding:11px 13px; width:100%; font-weight:600; outline:none; background:#fff; }
    .table-card { background:#fff; border:1px solid #e5ecef; border-radius:24px; padding:22px; box-shadow:0 16px 35px rgba(16,42,36,.07); }
    .audit-table { width:100%; border-collapse:separate; border-spacing:0 10px; }
    .audit-table thead th { color:#64748b; font-size:13px; font-weight:700; padding:0 14px 4px; border:0; }
    .audit-table tbody tr { background:#fff; box-shadow:0 8px 20px rgba(16,42,36,.05); }
    .audit-table tbody td { border-top:1px solid #edf2f4; border-bottom:1px solid #edf2f4; padding:14px; font-weight:600; color:#263238; vertical-align:middle; }
    .audit-table tbody td:first-child { border-right:1px solid #edf2f4; border-radius:0 16px 16px 0; }
    .audit-table tbody td:last-child { border-left:1px solid #edf2f4; border-radius:16px 0 0 16px; }
    .badge-audit { border-radius:50px; padding:7px 12px; font-size:12px; font-weight:700; background:#e8f7ef; color:#0f5132; display:inline-block; }
    .empty-box { background:#f8fafb; border:1px dashed #ccd6dd; border-radius:18px; padding:24px; text-align:center; color:#64748b; font-weight:700; }
    @@media(max-width:1100px){ .audit-grid{grid-template-columns:repeat(2,1fr);} .filter-form{grid-template-columns:1fr;} }
    @@media(max-width:600px){ .audit-grid{grid-template-columns:1fr;} }
</style>

<div class="audit-page">
    <div class="audit-actions">
        <a href="/Admin/Dashboard" class="audit-btn audit-btn-green">رجوع للوحة المدير</a>
        <a href="/Admin/Users" class="audit-btn audit-btn-light">إدارة المستخدمين</a>
        <a href="/Admin/Approvals/Pending" class="audit-btn audit-btn-light">طلبات النشر</a>
    </div>

    <div class="audit-grid">
        <div class="audit-card"><div class="audit-label">إجمالي العمليات</div><div class="audit-value">@Model.TotalLogs</div></div>
        <div class="audit-card"><div class="audit-label">عمليات اليوم</div><div class="audit-value">@Model.TodayLogs</div></div>
        <div class="audit-card"><div class="audit-label">عمليات المستخدمين</div><div class="audit-value">@Model.UserActions</div></div>
        <div class="audit-card"><div class="audit-label">عمليات النشر</div><div class="audit-value">@Model.ApprovalActions</div></div>
    </div>

    <div class="filter-card">
        <form method="get" action="/Admin/Audit" class="filter-form">
            <input name="search" value="@Model.Search" class="form-control-admin" placeholder="ابحث باسم المستخدم أو نوع العملية أو التفاصيل" />
            <select name="actionFilter" class="form-control-admin">
                <option value="All" selected="@(Model.ActionFilter == "All")">كل العمليات</option>
                <option value="User" selected="@(Model.ActionFilter == "User")">المستخدمين</option>
                <option value="Approve" selected="@(Model.ActionFilter == "Approve")">الموافقات</option>
                <option value="Reject" selected="@(Model.ActionFilter == "Reject")">الرفض</option>
            </select>
            <button class="audit-btn audit-btn-green" type="submit">بحث</button>
        </form>
    </div>

    <div class="table-card">
        @if (Model.Logs.Any())
        {
            <div class="table-responsive">
                <table class="audit-table">
                    <thead>
                        <tr>
                            <th>الوقت</th>
                            <th>المستخدم</th>
                            <th>البريد</th>
                            <th>العملية</th>
                            <th>التفاصيل</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Logs)
                        {
                            <tr>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.ActorName</td>
                                <td>@item.ActorEmail</td>
                                <td><span class="badge-audit">@item.Action</span></td>
                                <td>@item.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">لا توجد عمليات مسجلة حاليًا.</div>
        }
    </div>
</div>
