@model UniRemoteExam.Areas.Admin.ViewModels.ExamReportVm
@{
    ViewData["Title"] = "تقرير اختبار";
}
<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 16px;
        margin-bottom: 20px
    }

    .cardx {
        background: #fff;
        border: 1px solid #e5ecef;
        border-radius: 22px;
        padding: 20px;
        box-shadow: 0 12px 28px rgba(16,42,36,.06)
    }

    .label {
        color: #64748b;
        font-weight: 900;
        margin-bottom: 10px
    }

    .value {
        font-size: 30px;
        font-weight: 950;
        color: #102a24
    }

    .table-admin {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px
    }

        .table-admin th {
            color: #64748b;
            font-size: 13px;
            font-weight: 950;
            padding: 0 12px 5px
        }

        .table-admin td {
            background: #fff;
            border-top: 1px solid #edf2f4;
            border-bottom: 1px solid #edf2f4;
            padding: 14px 12px;
            font-weight: 800
        }

    .btn-admin {
        border: none;
        border-radius: 15px;
        padding: 9px 14px;
        font-weight: 950;
        text-decoration: none;
        display: inline-block
    }

    .btn-green {
        background: #0f5132;
        color: #fff
    }

    @@media(max-width:900px) {
        .grid {
            grid-template-columns: repeat(2,1fr)
        }
    }

    @@media(max - width:600px) {
        .grid {
            grid-template-columns: 1fr
        }
    }
</style>
<a href="/Admin/Reports" class="btn-admin btn-green" style="margin-bottom:15px">رجوع للتقارير</a> <a href="/Admin/Reports/ExportExamCsv/@Model.ExamId" class="btn-admin" style="margin-bottom:15px;background:#d4af37;color:#102a24">⬇ تصدير Excel/CSV</a>
<h2 style="font-weight:950;margin-bottom:16px">@Model.ExamTitle - @Model.CourseName</h2>
<div class="grid"><div class="cardx"><div class="label">الدرجة الكاملة</div><div class="value">@Model.MaxScore</div></div><div class="cardx"><div class="label">متوسط النتائج</div><div class="value">@Model.AvgScore</div></div><div class="cardx"><div class="label">نسبة النجاح</div><div class="value">@Model.PassRatePercent%</div></div><div class="cardx"><div class="label">نتائج مغلقة</div><div class="value">@Model.ClosedCount</div></div></div>
<div class="table-responsive"><table class="table-admin"><thead><tr><th>الطالب</th><th>البريد</th><th>الحالة</th><th>تلقائي</th><th>يدوي</th><th>الإجمالي</th><th>تاريخ التسليم</th><th>المراقبة</th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td>@r.StudentName</td><td>@r.StudentEmail</td><td>@r.Status</td><td>@r.AutoScore</td><td>@r.ManualScore</td><td>@r.TotalScore</td><td>@(r.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td><td><a href="/Admin/Reports/ProctorEvents?attemptId=@r.AttemptId" class="btn-admin" style="background:#f8fafc;color:#0b3a2e;border:1px solid #d8e2ee">سجل المراقبة</a></td></tr>}</tbody></table></div>
