@{
    ViewData["Title"] = "بوابة الطالب";
}

<div style="max-width:1200px;margin:24px auto;direction:rtl;text-align:right;padding:0 14px;">

    <div style="background:linear-gradient(135deg,#0b3a2e 0%,#0f5a47 55%,#16725a 100%);border-radius:28px;padding:28px;color:#fff;box-shadow:0 18px 40px rgba(11,58,46,.22);overflow:hidden;position:relative;">
        <div style="position:absolute;left:-40px;top:-40px;width:180px;height:180px;background:rgba(255,255,255,.07);border-radius:50%;"></div>
        <div style="position:absolute;left:80px;bottom:-55px;width:150px;height:150px;background:rgba(255,255,255,.05);border-radius:50%;"></div>

        <div style="position:relative;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;">
            <div>
                <div style="font-size:14px;font-weight:700;opacity:.9;margin-bottom:8px;">البوابة الأكاديمية للطالب</div>
                <div style="font-size:30px;font-weight:900;line-height:1.4;">مرحبًا بك في نظام الاختبارات 🎓</div>
                <div style="font-size:15px;opacity:.92;margin-top:8px;">
                    من هنا يمكنك بدء الاختبارات المنشورة، متابعة نتائجك، والاطلاع على إشعاراتك الأكاديمية بسهولة.
                </div>
            </div>

            <div style="display:flex;gap:12px;flex-wrap:wrap;">
                <a href="/Student/Exams/Index"
                   style="text-decoration:none;display:inline-flex;align-items:center;justify-content:center;padding:14px 22px;border-radius:16px;background:linear-gradient(90deg,#d4af37,#f4d77c);color:#0b3a2e;font-weight:900;box-shadow:0 10px 24px rgba(212,175,55,.35);min-width:190px;">
                    🧪 الاختبارات المنشورة
                </a>

                <a href="/Student/Results/Index"
                   style="text-decoration:none;display:inline-flex;align-items:center;justify-content:center;padding:14px 22px;border-radius:16px;background:rgba(255,255,255,.12);color:#fff;font-weight:800;border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(4px);min-width:160px;">
                    📊 النتائج
                </a>
            </div>
        </div>
    </div>

    <div class="student-home-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px;">

        <a href="/Student/Exams/Index" style="text-decoration:none;">
            <div style="background:#fff;border:1px solid #e7edf5;border-radius:22px;padding:22px;box-shadow:0 12px 24px rgba(15,23,42,.05);height:100%;transition:.2s;">
                <div style="font-size:38px;">🧪</div>
                <div style="font-size:22px;font-weight:900;color:#0b3a2e;margin-top:10px;">الاختبارات</div>
                <div style="color:#6b7280;margin-top:8px;line-height:1.8;">
                    ابدأ الدخول إلى الاختبارات المنشورة وحل الأسئلة بسهولة وبواجهة واضحة.
                </div>
            </div>
        </a>

        <a href="/Student/Results/Index" style="text-decoration:none;">
            <div style="background:#fff;border:1px solid #e7edf5;border-radius:22px;padding:22px;box-shadow:0 12px 24px rgba(15,23,42,.05);height:100%;">
                <div style="font-size:38px;">📈</div>
                <div style="font-size:22px;font-weight:900;color:#0b3a2e;margin-top:10px;">النتائج</div>
                <div style="color:#6b7280;margin-top:8px;line-height:1.8;">
                    تابع نتائجك ودرجاتك في الاختبارات فور نشرها بشكل مرتب واحترافي.
                </div>
            </div>
        </a>

        <div style="text-decoration:none;">
            <div style="background:#fff;border:1px solid #e7edf5;border-radius:22px;padding:22px;box-shadow:0 12px 24px rgba(15,23,42,.05);height:100%;">
                <div style="font-size:38px;">🔔</div>
                <div style="font-size:22px;font-weight:900;color:#0b3a2e;margin-top:10px;">إرشادات الاختبار</div>
                <div style="color:#6b7280;margin-top:8px;line-height:1.8;">
                    يظهر سؤال واحد في كل مرة، وبعد انتهاء الوقت ينتقل النظام تلقائيًا للسؤال التالي.
                </div>
            </div>
        </div>
    </div>

    <div style="margin-top:20px;background:#fff;border:1px solid #e7edf5;border-radius:22px;box-shadow:0 12px 24px rgba(15,23,42,.05);padding:22px;">
        <div style="font-size:22px;font-weight:900;color:#0b3a2e;">✨ نصائح قبل بدء الاختبار</div>

        <div class="tips-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px;">
            <div style="background:#f8fafc;border:1px solid #eef2f7;border-radius:18px;padding:16px;">
                <div style="font-weight:900;color:#0b3a2e;">التأكد من الاتصال</div>
                <div style="color:#6b7280;margin-top:6px;line-height:1.8;">تأكد من استقرار الإنترنت قبل بدء أي اختبار لتجنب الانقطاع أثناء الحل.</div>
            </div>

            <div style="background:#f8fafc;border:1px solid #eef2f7;border-radius:18px;padding:16px;">
                <div style="font-weight:900;color:#0b3a2e;">قراءة التعليمات</div>
                <div style="color:#6b7280;margin-top:6px;line-height:1.8;">اقرأ تعليمات الاختبار بعناية قبل الضغط على زر البدء.</div>
            </div>

            <div style="background:#f8fafc;border:1px solid #eef2f7;border-radius:18px;padding:16px;">
                <div style="font-weight:900;color:#0b3a2e;">إرسال الإجابات</div>
                <div style="color:#6b7280;margin-top:6px;line-height:1.8;">بعد الانتهاء تأكد من حفظ وإرسال إجاباتك قبل انتهاء الوقت.</div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media (max-width: 992px) {
        .student-home-grid,
        .tips-grid {
            grid-template-columns: 1fr !important;
        }
    }
</style>