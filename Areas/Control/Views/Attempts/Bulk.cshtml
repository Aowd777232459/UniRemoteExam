@model List<UniRemoteExam.Data.Exam>

<div class="container mt-4">
    <div class="app-card p-4 mb-3">
        <h3 class="section-title mb-1">إرسال النتائج بالجملة</h3>
        <div class="small-muted">اختر اختبارًا لإرسال النتائج لجميع الطلاب (محاولات Closed فقط).</div>
    </div>

    @if (TempData["BulkMsg"] != null)
    {
        <div class="alert alert-success">@TempData["BulkMsg"]</div>
    }

    <div class="app-card p-3">
        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">لا يوجد اختبارات لها محاولات مغلقة (Closed) حتى الآن.</div>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ExamId</th>
                        <th>الاختبار</th>
                        <th>المادة</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.ExamId</td>
                            <td>@e.Title</td>
                            <td>@(e.Course?.Name ?? e.CourseName ?? "-")</td>
                            <td class="text-end">
                                <form method="post" action="/Control/Attempts/SendAllForExam">
                                @Html.AntiForgeryToken()
                                    <input type="hidden" name="examId" value="@e.ExamId" />
                                    <button type="submit" class="btn btn-brand btn-sm">
                                        إرسال النتائج لجميع الطلاب
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>