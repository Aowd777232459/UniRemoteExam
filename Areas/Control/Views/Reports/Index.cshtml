@model List<UniRemoteExam.Data.Exam>
@{
    ViewData["Title"] = "تقارير الاختبارات";
}

<div class="container mt-4">
    <div class="app-card p-4 mb-3">
        <h3 class="section-title mb-1">تقارير الاختبارات</h3>
        <div class="small-muted">اختر اختبارًا لعرض النتائج والإحصائيات.</div>
    </div>

    <div class="app-card p-3">
        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">لا يوجد اختبارات حتى الآن.</div>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ExamId</th>
                        <th>الاختبار</th>
                        <th>المادة</th>
                        <th>منشور؟</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.ExamId</td>
                            <td class="fw-bold text-primary">@e.Title</td>
                            <td>@(e.Course?.Name ?? e.CourseName ?? "-")</td>
                            <td>
                                <span class="badge @(e.IsPublished ? "bg-success" : "bg-secondary")">
                                    @(e.IsPublished ? "نعم" : "لا")
                                </span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-brand btn-sm" href="/Admin/Reports/Exam/@e.ExamId">فتح التقرير</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>