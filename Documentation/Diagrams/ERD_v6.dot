digraph ERD {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.8, fontname="DejaVu Sans"];
  node [shape=record, style="rounded,filled", fillcolor="#f8fafc", color="#0b3a2e", fontname="DejaVu Sans", fontsize=10];
  edge [color="#64748b", arrowsize=0.7];
  Roles [label="{Roles|RoleId PK|RoleName}"];
  Users [label="{Users|UserId PK|RoleId FK|Email|PasswordHash|MustChangePassword|LockedUntil}"];
  Departments [label="{Departments|DepartmentId PK|Code|Name}"];
  Terms [label="{AcademicTerms|AcademicTermId PK|Name|StartDate|EndDate}"];
  Courses [label="{Courses|CourseId PK|DepartmentId FK|AcademicTermId FK|TeacherId FK|Code|Name}"];
  Enrollments [label="{CourseEnrollments|EnrollmentId PK|CourseId FK|StudentId FK|IsActive}"];
  Exams [label="{Exams|ExamId PK|CourseId FK|TeacherId FK|Status|DurationMinutes|PassPercentage}"];
  Questions [label="{Questions|QuestionId PK|ExamId FK|QuestionType|Points|TimeLimitSeconds}"];
  Choices [label="{QuestionChoices|ChoiceId PK|QuestionId FK|ChoiceText}"];
  Keys [label="{AnswerKeyItems|ExamId PK/FK|QuestionId PK/FK|CorrectChoiceId FK|CorrectBool|ModelAnswer}"];
  Publish [label="{ExamPublishRequests|RequestId PK|ExamId FK|TeacherId FK|Status}"];
  Attempts [label="{ExamAttempts|AttemptId PK|ExamId FK|StudentId FK|Status|ExpiresAt|FinalScore|Percentage|IsPassed}"];
  Answers [label="{AttemptAnswers|AttemptAnswerId PK|AttemptId FK|QuestionId FK|Confirmed|LockedAt}"];
  Scores [label="{ManualScores|ManualScoreId PK|AttemptId FK|QuestionId FK|Score}"];
  Proctor [label="{ProctorEvents|ProctorEventId PK|AttemptId FK|StudentId FK|EventType}"];
  Audit [label="{AuditLogs|AuditId PK|ActorUserId FK|Action|CreatedAt}"];
  Email [label="{EmailLogs|EmailLogId PK|UserId FK|Status|SentAt}"];
  Roles -> Users [label="1:N"];
  Users -> Courses [label="teacher 1:N"];
  Departments -> Courses [label="1:N"];
  Terms -> Courses [label="1:N"];
  Courses -> Enrollments [label="1:N"];
  Users -> Enrollments [label="student 1:N"];
  Courses -> Exams [label="1:N"];
  Users -> Exams [label="teacher 1:N"];
  Exams -> Questions [label="1:N"];
  Questions -> Choices [label="1:N"];
  Exams -> Keys [label="1:N"];
  Questions -> Keys [label="1:1"];
  Exams -> Publish [label="1:N"];
  Exams -> Attempts [label="1:N"];
  Users -> Attempts [label="student 1:N"];
  Attempts -> Answers [label="1:N"];
  Questions -> Answers [label="1:N"];
  Attempts -> Scores [label="1:N"];
  Questions -> Scores [label="1:N"];
  Attempts -> Proctor [label="1:N"];
  Users -> Audit [label="actor"];
  Users -> Email [label="recipient"];
}
