<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniRemoteExam.Client.App"
             UserAppTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BrandPrimary">#073B31</Color>
            <Color x:Key="BrandSecondary">#0F6B55</Color>
            <Color x:Key="BrandGold">#CAA44A</Color>
            <Color x:Key="AppBackground">#F4F7FB</Color>
            <Color x:Key="TextPrimary">#102A24</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                <Setter Property="TextColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
