@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="login-page">
    <div class="login-wrapper">
        <div class="row g-0 login-card shadow-lg overflow-hidden">

            <div class="col-lg-6 login-side-info d-none d-lg-flex">
                <div class="login-side-content">
                    <div class="login-badge">جامعة صنعاء</div>

                    <div class="login-side-logo-wrap">
                        <img src="/images/sanaa-university-logo.jpg"
                             alt="شعار جامعة صنعاء"
                             class="login-side-logo">
                    </div>

                    <h1 class="login-system-title">
                        نظام الاختبارات الإلكترونية عن بُعد
                    </h1>

                    <p class="login-system-text">
                        منصة جامعية لإدارة الاختبارات الإلكترونية للطلاب والدكاترة والإدارة والكنترول
                        بطريقة منظمة وآمنة وسهلة الاستخدام.
                    </p>

                    <div class="login-features">
                        <div class="login-feature-item">
                            <span class="login-feature-icon">✓</span>
                            <span>إجراء الاختبارات عن بُعد بسهولة</span>
                        </div>

                        <div class="login-feature-item">
                            <span class="login-feature-icon">✓</span>
                            <span>إدارة كاملة للمواد والأسئلة والمحاولات</span>
                        </div>

                        <div class="login-feature-item">
                            <span class="login-feature-icon">✓</span>
                            <span>متابعة النتائج والتصحيح بشكل منظم</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="login-form-panel">
                    <div class="text-center mb-4">
                        <div class="login-top-logo-wrap mb-3">
                            <img src="/images/sanaa-university-logo.jpg"
                                 alt="شعار جامعة صنعاء"
                                 class="login-top-logo">
                        </div>

                        <h2 class="login-form-title">مرحبًا بعودتك</h2>
                        <p class="login-form-subtitle mb-0">
                            سجل الدخول باستخدام بياناتك الجامعية
                        </p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger login-alert" role="alert">
                            @ViewBag.Error
                        </div>
                    }

                    <form method="post" action="/Account/Login" id="loginForm" novalidate>
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="email" class="form-label login-label">البريد الإلكتروني</label>
                            <div class="input-group login-input-group">
                                <span class="input-group-text">📧</span>
                                <input id="email"
                                       name="email"
                                       type="text"
                                       class="form-control login-input"
                                       placeholder="أدخل البريد الإلكتروني"
                                       required
                                       autocomplete="username" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label login-label">كلمة المرور</label>
                            <div class="input-group login-input-group">
                                <span class="input-group-text">🔒</span>
                                <input id="password"
                                       name="password"
                                       type="password"
                                       class="form-control login-input"
                                       placeholder="أدخل كلمة المرور"
                                       required
                                       autocomplete="current-password" />
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    إظهار
                                </button>
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-brand btn-lg login-submit-btn" id="loginBtn">
                                تسجيل الدخول
                            </button>
                        </div>

                        <div class="login-help-text mt-4 text-center">
                            <span>الأدوار المتاحة داخل النظام:</span>
                            <div class="mt-2 d-flex flex-wrap justify-content-center gap-2">
                                <span class="badge text-bg-light border">طالب</span>
                                <span class="badge text-bg-light border">دكتور</span>
                                <span class="badge text-bg-light border">إدارة</span>
                                <span class="badge text-bg-light border">كنترول</span>
                            </div>
                        </div>
                    </form>



                    <div class="mt-3 p-3 rounded-4 border" style="background:#f8fafc;">
                        <div class="fw-bold mb-2" style="color:#0b3a2e;">حسابات العرض التجريبية</div>
                        <div class="small text-muted" style="line-height:1.9;">
                            المدير: <b>admin@sanaau.edu.ye</b> / Demo@12345<br />
                            الدكتور: <b>teacher@sanaau.edu.ye</b> / Demo@12345<br />
                            الطالب: <b>student1@sanaau.edu.ye</b> / Demo@12345
                        </div>
                    </div>

                    <div class="login-footer-note text-center mt-4">
                        يرجى استخدام بياناتك الرسمية للدخول إلى النظام
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const togglePasswordBtn = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');
        const loginForm = document.getElementById('loginForm');
        const loginBtn = document.getElementById('loginBtn');

        if (togglePasswordBtn && passwordInput) {
            togglePasswordBtn.addEventListener('click', function () {
                const isPassword = passwordInput.getAttribute('type') === 'password';
                passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                togglePasswordBtn.textContent = isPassword ? 'إخفاء' : 'إظهار';
            });
        }

        if (loginForm && loginBtn) {
            loginForm.addEventListener('submit', function () {
                loginBtn.disabled = true;
                loginBtn.innerHTML = '<span class="spinner-border spinner-border-sm ms-2"></span> جاري تسجيل الدخول...';
            });
        }
    </script>
}