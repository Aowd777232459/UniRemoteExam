@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

<div class="production-page" dir="rtl">
    <div class="pro-hero compact-hero">
        <div>
            <div class="eyebrow">أمان الحساب</div>
            <h2>تغيير كلمة المرور</h2>
            <p>استخدم كلمة مرور قوية لحماية حسابك الجامعي، ويفضل ألا تقل عن 8 أحرف وتحتوي على أرقام وحروف.</p>
        </div>
        <div class="hero-badge">🔐 حماية</div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger fw-bold">@ViewBag.Error</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">@TempData["Success"]</div>
    }

    <div class="pro-card max-720">
        <form method="post" action="/Account/ChangePassword">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-bold">كلمة المرور الحالية</label>
                <input name="currentPassword" type="password" class="form-control pro-input" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">كلمة المرور الجديدة</label>
                <input name="newPassword" type="password" class="form-control pro-input" minlength="8" required />
                <div class="form-text">لا تستخدم كلمات سهلة مثل 123456 في البيئة الفعلية.</div>
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold">تأكيد كلمة المرور الجديدة</label>
                <input name="confirmPassword" type="password" class="form-control pro-input" minlength="8" required />
            </div>
            <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">حفظ كلمة المرور</button>
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">رجوع</a>
        </form>
    </div>
</div>
