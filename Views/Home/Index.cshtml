@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "الرئيسية";
    var roleName = Context.Session.GetString("RoleName") ?? "";
    var isLoggedIn = Context.Session.GetInt32("UserId").HasValue;
    var dashboardUrl = roleName switch
    {
        "Admin" => "/Admin/Dashboard",
        "Teacher" => "/Teacher/Exams",
        "Student" => "/Student/Home",
        "Control" => "/Control/Home",
        _ => "/Account/Login"
    };
}

<div class="container-fluid px-0">
    <section class="defense-hero mb-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="defense-badge">🎓 جامعة صنعاء - كلية أرحب للعلوم التطبيقية</span>
                <h1 class="defense-title">نظام الاختبارات الإلكترونية</h1>
                <p class="defense-subtitle">
                    منصة جامعية لإدارة دورة الاختبار كاملة: إنشاء الاختبار، نموذج الإجابة، اعتماد النشر، أداء الطالب سؤالًا بسؤال، المراقبة، التصحيح، التقارير والنتائج.
                </p>
                <div class="d-flex gap-2 flex-wrap mt-4">
                    <a href="@dashboardUrl" class="btn btn-lg" style="background:linear-gradient(90deg,#caa44a,#f3d47b);color:#102a24;font-weight:700;border-radius:18px;padding:13px 22px;">@(isLoggedIn ? "الدخول إلى لوحتي" : "تسجيل الدخول")</a>
                    <a href="#workflow" class="btn btn-lg btn-outline-light" style="border-radius:18px;font-weight:700;padding:13px 22px;">استعراض سير النظام</a>
                </div>
            </div>
            <div class="col-lg-4 text-center">
                <div class="defense-logo-card">
                    <img src="/images/sanaa-university-logo.jpg" alt="شعار جامعة صنعاء" />
                </div>
            </div>
        </div>
    </section>

    <div class="ui-stat-grid mb-4">
        <a href="/Admin/Dashboard" class="ui-stat-card text-decoration-none">
            <div class="ui-stat-icon">🏛️</div><div class="ui-stat-label">الإدارة</div><div class="ui-stat-value">اعتماد ورقابة</div><div class="small-muted mt-2">إدارة المستخدمين وطلبات النشر والتقارير.</div>
        </a>
        <a href="/Teacher/Exams" class="ui-stat-card text-decoration-none">
            <div class="ui-stat-icon">👨‍🏫</div><div class="ui-stat-label">الدكتور</div><div class="ui-stat-value">إنشاء الاختبارات</div><div class="small-muted mt-2">أسئلة، أوقات، نموذج إجابة، وطلب نشر.</div>
        </a>
        <a href="/Student/Exams" class="ui-stat-card text-decoration-none">
            <div class="ui-stat-icon">🎓</div><div class="ui-stat-label">الطالب</div><div class="ui-stat-value">اختبار آمن</div><div class="small-muted mt-2">سؤال واحد في كل مرة مع وقت مستقل.</div>
        </a>
        <a href="/Control/Attempts" class="ui-stat-card text-decoration-none">
            <div class="ui-stat-icon">🧾</div><div class="ui-stat-label">الكنترول</div><div class="ui-stat-value">تصحيح ونتائج</div><div class="small-muted mt-2">تصحيح المقالات واعتماد النتائج النهائية.</div>
        </a>
    </div>

    <section id="workflow" class="ui-card mb-4">
        <div class="ui-card-header">
            <h2 class="ui-card-title">سير العمل داخل النظام</h2>
            <span class="badge text-bg-light border">من الإنشاء إلى النتيجة</span>
        </div>
        <div class="ui-card-body">
            <div class="timeline-flow">
                <div class="timeline-step"><div class="num">1</div><b>إنشاء الاختبار</b><p class="small-muted mb-0 mt-2">الدكتور يضيف البيانات والأسئلة والوقت.</p></div>
                <div class="timeline-step"><div class="num">2</div><b>نموذج الإجابة</b><p class="small-muted mb-0 mt-2">صفحة مستقلة للإجابات الصحيحة.</p></div>
                <div class="timeline-step"><div class="num">3</div><b>اعتماد النشر</b><p class="small-muted mb-0 mt-2">المدير يراجع ثم يعتمد أو يرفض.</p></div>
                <div class="timeline-step"><div class="num">4</div><b>تنفيذ الاختبار</b><p class="small-muted mb-0 mt-2">الطالب يجيب سؤالًا بسؤال.</p></div>
                <div class="timeline-step"><div class="num">5</div><b>التصحيح والنتائج</b><p class="small-muted mb-0 mt-2">الكنترول يعتمد النتيجة والتقارير.</p></div>
            </div>
        </div>
    </section>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="ui-card h-100">
                <div class="ui-card-header"><h3 class="ui-card-title">نقاط القوة في المناقشة</h3></div>
                <div class="ui-card-body">
                    <div class="row g-3">
                        <div class="col-md-6"><div class="p-3 rounded-4 border bg-light h-100"><b>⏱️ وقت لكل سؤال</b><p class="small-muted mb-0 mt-2">قفل السؤال من السيرفر وليس من المتصفح فقط.</p></div></div>
                        <div class="col-md-6"><div class="p-3 rounded-4 border bg-light h-100"><b>🛡️ مراقبة سلوك الطالب</b><p class="small-muted mb-0 mt-2">تسجيل الخروج من الصفحة ومحاولات النسخ.</p></div></div>
                        <div class="col-md-6"><div class="p-3 rounded-4 border bg-light h-100"><b>🔀 عشوائية الأسئلة</b><p class="small-muted mb-0 mt-2">تقليل الغش بترتيب مختلف لكل طالب.</p></div></div>
                        <div class="col-md-6"><div class="p-3 rounded-4 border bg-light h-100"><b>📊 تقارير إدارية</b><p class="small-muted mb-0 mt-2">تصدير النتائج وسجل العمليات.</p></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="ui-card h-100">
                <div class="ui-card-header"><h3 class="ui-card-title">هوية المشروع</h3></div>
                <div class="ui-card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="/images/sanaa-university-logo.jpg" alt="شعار جامعة صنعاء" style="width:110px;height:80px;object-fit:contain;border:1px solid #e7edf2;border-radius:18px;padding:6px;background:#fff" />
                        <div><b>نظام الاختبارات الإلكترونية</b><div class="small-muted">مشروع تخرج جامعي</div></div>
                    </div>
                    <div class="alert alert-success mb-0">النظام مصمم بواجهات عربية RTL وبهوية جامعية مناسبة للعرض أمام لجنة المناقشة.</div>
                </div>
            </div>
        </div>
    </div>
</div>
